# Copy to .env and replace blank credential values with your own.
# Never commit .env. Keep .env.example free of real secrets.
APP_ENV=local
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
# Generate a unique, long random value for each environment.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Paste the MongoDB Atlas connection string from Atlas > Connect > Drivers.
# URL-encode special characters in the database username/password.
MONGODB_URI=
MONGODB_DATABASE=sentinel
REDIS_URL=redis://localhost:6379/0

# SMTP credentials for account verification, password reset, and alerts.
# Leave blank until an email provider is configured.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM_ADDRESS=

# Billing integration. Leave blank/disabled until a provider is selected.
BILLING_PROVIDER=disabled
BILLING_SECRET_KEY=
BILLING_WEBHOOK_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:8000
